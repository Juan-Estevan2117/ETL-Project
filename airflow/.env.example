# Copiar este archivo a `.env` en el mismo directorio y completar los valores.
# Tanto docker-compose (servicio mysql-dw) como el pipeline local (src/main.py)
# leen de este archivo. Mantener ambos sincronizados.

# ---------- Linux host UID (Airflow en Linux) ----------
# En Linux ejecutar `id -u` y pegar el resultado aquí para que los archivos
# escritos por los contenedores de Airflow pertenezcan al usuario del host.
AIRFLOW_UID=1000

# ---------- MySQL Data Warehouse ----------
# El puerto del host es 3307 para evitar colisiones con un MySQL nativo en 3306.
# Dentro de la red Docker, los servicios acceden vía mysql-dw:3306 (puerto interno).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=etl_user
MYSQL_PASSWORD=etl_password
MYSQL_DW_DB=dw_matriculas_col

# ---------- Dataset primario (auto-descarga desde Google Drive) ----------
# ID del archivo en Drive ("Cualquiera con el enlace"). El pipeline descarga el
# CSV a airflow/data/raw/educacionCol.csv si no existe; así no se versiona el dataset.
PRIMARY_CSV_GDRIVE_ID=15o5NuExauHCOE_PQSerAG5WHNilwnxuc

# ---------- API Socrata (ICETEX) ----------
# Token opcional — aumenta el rate limit de la API de datos.gov.co
SOCRATA_APP_TOKEN=

# ---------- Streaming Kafka (Entrega Final) ----------
# Broker Kafka levantado por kafka/docker-compose.kafka.yaml (modo KRaft, sin Zookeeper).
# Los scripts del host (producer/consumer) conectan a localhost:9092.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=dw-metrics-stream
# Segundos entre cada re-consulta y re-publicación de métricas del producer.
STREAM_DELAY_SECONDS=5
